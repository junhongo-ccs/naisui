# Dify接続設定の見本。backend/.env にコピーして値を入れる（backend/.env はコミットしない）。
# 起動例: uvicorn app.main:app --env-file .env （backend/ で実行）

# DifyのAPIのベースURL。クラウド版は https://api.dify.ai/v1 、セルフホストは http://<host>/v1
DIFY_BASE_URL=https://api.dify.ai/v1

# Difyのチャットアプリの「APIアクセス」で発行したキー（app-で始まる）
DIFY_API_KEY=

# 応答を待つ秒数。超えたらテンプレート応答に戻す
DIFY_TIMEOUT_SECONDS=30
